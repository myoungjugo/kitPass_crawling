# 진단 로그
DIAG_VERBOSE=1
DIAG_LOG=1

# 대시보드 로그인 (설정 안 하면 인증 없이 열림 - 로컬 개발 편의용, 배포 전엔 꼭 설정!)
ADMIN_PASSWORD=
FLASK_SECRET_KEY=change-me-to-something-random

# 원화 환산 (환율은 exchangerate-api.com 오픈 엔드포인트, 하루 1회 갱신 - 완전 실시간 아님)
# 기본 1시간(3600초)마다만 재조회. 굳이 더 자주 조회할 필요는 없음(원본 데이터가 하루 1번 바뀜)
FX_CACHE_TTL_SEC=3600

# Discord 알림 (기본 off — 서버_설정 문서 기준: 웹사이트 연결 없이 개인용 Discord 알림만)
# on/off, 가격 상한은 대시보드(app.py) 화면에서 토글합니다.
# data/results/notify_settings.json 에 저장되며, 아래 웹훅 URL만 여기서 설정하면 됩니다.
DISCORD_WEBHOOK_URL=

# Classic Football Shirts: 상품이 10만개+라 안전장치로 이번 실행에서 열어볼 상세페이지 수 제한
CFS_MAX_PRODUCTS=1000

# Kitbag: 플랫폼이 바뀌어서 실제 도메인/카테고리 경로가 다를 수 있음. 확인 후 필요시 수정.
KITBAG_BASE_URL=https://www4.kitbag.com
KITBAG_CATEGORY_PATH=/en/football-kits-shirts-home/d-15954-15956
KITBAG_MAX_PAGES=5
KITBAG_MAX_PRODUCTS=500

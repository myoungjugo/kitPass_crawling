# --- 가상환경 ---
venv/
.venv/
env/
ENV/

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# --- 환경변수 (Discord 웹훅 URL 등 민감정보 포함) ---
.env
.env.*
!.env.example

# --- 수집 결과물 / 로그 (실행할 때마다 생성되는 데이터, 코드 아님) ---
data/results/*.json
data/results/*.tmp
data/diagnostics/*.jsonl
!data/results/.gitkeep
!data/diagnostics/.gitkeep

# --- 에디터/OS ---
.vscode/
.idea/
.DS_Store
